-- E18
-- Liste os nomes dos cursos sem repetições que possuam alunos matriculados e 
-- sejam ministrados na sala '20 AVW' (skipado -> só unir as tabelas faz com que apenas cursos com alunos matriculados apareçam)

-- E19
-- Encontre os números dos alunos sem repetição que estão matriculados 
-- em pelo menos dois cursos que são ministrados na mesma sala.
SELECT DISTINCT A.nroAlun 
FROM ALUNO A, MATRICULADO M1, CURSO C1, MATRICULADO M2, CURSO C2
WHERE M1.nomeCurso = C1.nome 
AND M2.nomeCurso = C2.nome
AND A.nroAlun = M1.nroAlun AND A.nroAlun = M2.nroAlun
AND C1.sala = C2.sala
AND C1.nome != C2.nome;

-- E20
-- Encontre o nome do professor que ministra pelo menos dois cursos. (mesmo esquema)
SELECT DISTINCT nomeProf
FROM PROFESSOR P, CURSO C1, CURSO C2
WHERE P.idProf = C1.idProf 
AND P.idProf = C2.idProf
AND C1.nome != C2.nome;

-- E21
-- Encontre o nome do professor que ministra pelo menos três cursos. (mesmo esquema)
SELECT DISTINCT nomeProf
FROM PROFESSOR P, CURSO C1, CURSO C2, CURSO C3
WHERE P.idProf = C1.idProf
AND P.idProf = C2.idProf
AND P.idProf = C3.idProf
AND C1.nome != C2.nome
AND C1.nome != C3.nome
AND C2.nome != C3.nome;

