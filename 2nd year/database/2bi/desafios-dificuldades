-- Liste todos os cursos e, caso ele tenha algum aluno matriculado do nível 'JR', 
-- imprima o nome do aluno.

SELECT nome, A.nomeAlun
FROM
CURSO C 
LEFT JOIN MATRICULADO M
ON (nome = nomeCurso) 
LEFT JOIN ALUNO A
ON (A.nroAlun = M.nroAlun AND nivel = 'JR')


