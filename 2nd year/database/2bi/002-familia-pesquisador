--1 - Escreva uma consulta que retorne o nome científico e o 
--local de coleta de todos os espécimes que foram coletados 
--em locais que contenham a palavra "Mata" em sua descrição.
SELECT nome_cientifico, local_coleta 
FROM especime
WHERE local_coleta ILIKE '%Mata%';

--2 - Apresente uma lista contendo o nome científico do espécime 
-- e o nome da família botânica à qual ele pertence.
SELECT e.nome_cientifico, f.nome_familia
FROM especime e INNER JOIN familia f
ON (e.id_familia = f.id_familia);

--3 - Crie uma consulta que mostre o nome de cada família 
-- botânica e a quantidade total de espécimes registrados 
-- para cada uma delas no herbário.
SELECT nome_familia, COUNT (*)
FROM familia f INNER JOIN especime e
ON (f.id_familia = e.id_familia)
GROUP BY nome_familia;

--4 - A coordenação precisa de um relatório de 
-- produtividade dos pesquisadores. Escreva uma consulta que 
-- liste o nome de todos os pesquisadores cadastrados e os nomes
-- científicos dos espécimes que eles coletaram. Caso um 
-- pesquisador ainda não tenha registrado nenhuma coleta, 
-- seu nome ainda deve aparecer no resultado (com o valor nulo 
-- para o espécime).
SELECT nome_pesquisador, nome_cientifico
FROM pesquisador p LEFT OUTER JOIN especime e 
ON (p.id_pesquisador = e.id_pesquisador)
ORDER BY nome_pesquisador;


--5 - Escreva uma consulta que retorne o nome dos pesquisadores da 
-- instituição 'UTFPR' e a quantidade de espécimes que cada um coletou. 
-- O resultado deve agrupar os dados pelo nome do pesquisador.
SELECT nome_pesquisador, COUNT(*)
FROM pesquisador p LEFT JOIN especime e
ON (p.id_pesquisador = e.id_pesquisador)
GROUP BY nome_pesquisador;

--6 - A diretoria do herbário quer focar seus estudos nas 
-- famílias mais representativas do acervo. 
-- Crie uma consulta que retorne o nome das famílias botânicas 
-- que possuem mais de um espécime cadastrado na base de dados.
SELECT nome_familia
FROM familia f, especime e
WHERE f.id_familia = e.id_familia;
