--7 - Elabore uma consulta que apresente um relatório 
-- consolidado de coleta contendo: o nome científico do espécime, 
-- o nome da família botânica à qual ele pertence e o nome do 
-- pesquisador responsável por aquela coleta.
SELECT nome_cientifico, nome_familia, nome_pesquisador
FROM especime e INNER JOIN familia f
ON (e.id_familia = f.id_familia)
INNER JOIN pesquisador p
ON (p.id_pesquisador = e.id_pesquisador);


--8 - Precisamos identificar os membros da equipe que ainda precisam 
-- ir a campo. Utilizando uma junção externa, escreva uma 
-- consulta que retorne o nome dos pesquisadores que não possuem 
-- nenhum espécime vinculado ao seu registro.
SELECT nome_pesquisador, nome_cientifico
FROM pesquisador p LEFT OUTER JOIN especime e
ON (p.id_pesquisador = e.id_pesquisador)
WHERE nome_cientifico IS NULL;

--9 - A equipe de botânica precisa revisar as coletas feitas perto 
-- de cursos d'água ou em áreas de mata fechada. Gere uma 
-- lista com o nome científico e a data de coleta dos espécimes 
-- cujo local de coleta comece com a palavra 'Mata' ou contenha a 
-- palavra 'Rio'.
SELECT nome_cientifico, data_coleta, local_coleta
FROM especime 
WHERE local_coleta LIKE 'Mata%' 
OR local_coleta LIKE '%Rio%'


--10 - Para fins de auditoria histórica, crie uma consulta
-- que exiba a data da coleta mais antiga (primeira coleta) e a 
-- data da coleta mais recente (última coleta) registradas em 
-- todo o acervo do herbário.
SELECT MIN(data_coleta), MAX(data_coleta)
FROM especime

