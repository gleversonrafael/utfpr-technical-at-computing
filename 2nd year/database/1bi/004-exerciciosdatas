---------------------- TABELAS
-- REMOÇÕES
DROP TABLE IF EXISTS USUARIOS, EVENTOS;

-- CRIAÇÕES
CREATE TABLE IF NOT EXISTS USUARIOS(
	id SERIAL PRIMARY KEY,
	
	nome TEXT NOT NULL,
	ultimo_acesso TIMESTAMP
);

CREATE TABLE IF NOT EXISTS EVENTOS(
	id SERIAL PRIMARY KEY,

	cts TIMESTAMP,
	ctsz TIMESTAMPTZ
);


