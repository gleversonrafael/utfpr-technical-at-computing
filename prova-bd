-- Questão 3
--------------------------------------------------------------------
-- Escreva uma consulta SQL que liste o nome_disciplina das disciplinas que NUNCA tiveram matrículas de alunos do curso de 'Medicina'
-- Alunos matriculados em cursos que não sejam de medicina.
-- Mostre disciplinas que têm alunos matriculados, e retire os de medicina
SELECT *
FROM DISCIPLINA D 
JOIN MATRICULA M ON
	(D.id_disciplina = M.id_disciplina)
JOIN ALUNO A ON
	(M.id_aluno = A.id_aluno)
WHERE curso != 'Medicina';

--
SELECT nome, curso
FROM DISCIPLINA D 
JOIN MATRICULA M ON
	(D.id_disciplina = M.id_disciplina)
JOIN ALUNO A ON
	(M.id_aluno = A.id_aluno)
WHERE A.id_aluno NOT IN (
	SELECT A.id_aluno
	FROM DISCIPLINA D 
	JOIN MATRICULA M ON
		(D.id_disciplina = M.id_disciplina)
	JOIN ALUNO A ON 
		(M.id_aluno = A.id_aluno)
	WHERE curso = 'Medicina'
);


